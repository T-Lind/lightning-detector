{
  "name": "lightning-detector-cloud",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute lightning-v1 --local --file=schema.sql",
    "db:remote": "wrangler d1 execute lightning-v1 --remote --file=schema.sql",
    "test": "node --test test/*.test.js",
    "test:event": "node scripts/send-event.js"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
