{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lightning-detector",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lightning-v1",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "DEVICE_ID": "yard-1",
    "DEVICE_LABEL": "Lightning station"
  },
  "triggers": {
    "crons": [
      "23 4 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
